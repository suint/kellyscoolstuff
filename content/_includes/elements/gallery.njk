<div class="frame gallery" style='width: {{ galleryWidth }}px;'>
  <div id="gallery">
  {% for image in galleryImages %}
    <div class="gallery-item" {% if itemHeight %} style='height: {{ itemHeight }}px;' {% endif %} > {# default is 300px #}
        <img src="{{ nesting }}images/{{ image.fileName }}"  {% if itemHeight %} style='height: {{ itemHeight }}px;' {% endif %}
        {% if image.altText %}alt="{{ image.altText }}" {% endif %}/>
        <div class="image-overlay">
          {% if image.title %}
          <span class="image-title">
              {% if image.link %}
              <span class="image-link"><a href="{{ image.link }}" target="_blank">{{ image.title }}➚</a></span>
              {% else %}
              {{ image.title }}
              {% endif %}
          </span>
          {% endif %}
          {% if image.caption %}
          <span class="image-caption">{{ image.caption }}</span>
          {% endif %}
        </div>
    </div>
  {% endfor %}
  </div>
</div>